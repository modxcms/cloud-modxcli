{
  "name": "modx/cloudcli",
  "description": "CLI helper tool for working with MODX Revolution in MODX Cloud",
  "version": "0.0.2-beta",
  "autoload": {
    "psr-4": {
      "MODX\\CloudCLI\\": [
        "src/"
      ]
    }
  },
  "config": {
    "platform": {
      "php": "7.4"
    }
  },
  "require": {
    "php": ">=7.4",
    "mnapoli/silly": "^1.9",
    "symfony/finder": "^5.4",
    "php-di/php-di": "^6.4",
    "ext-json": "*"
  },
  "require-dev": {
    "modx/revolution": "^3.1"
  }
}
